# Confluence Demo Environment Configuration
# Copy this to .env and fill in your values:
#   cp example.env .env

# =============================================================================
# Confluence Configuration
# =============================================================================

# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_API_TOKEN=your-api-token-here

# Your Atlassian account email
CONFLUENCE_EMAIL=your-email@example.com

# Your Confluence Cloud instance URL
CONFLUENCE_SITE_URL=https://your-site.atlassian.net

# =============================================================================
# Demo Space Configuration
# =============================================================================

# Option A: Create new demo space (set SEED_DEMO_DATA=true)
DEMO_SPACE_KEY=CDEMO
DEMO_SPACE_NAME="Confluence Demo Space"
SEED_DEMO_DATA=true

# Option B: Use existing space (set SEED_DEMO_DATA=false)
# DEMO_SPACE_KEY=EXISTING
# SEED_DEMO_DATA=false

# Label for preserved content (not deleted during cleanup)
DEMO_PRESERVE_LABEL=demo

# =============================================================================
# Session Configuration
# =============================================================================

# Maximum session duration in minutes
SESSION_TIMEOUT_MINUTES=60

# Maximum number of people in queue
MAX_QUEUE_SIZE=10

# =============================================================================
# Claude Authentication (one required)
# =============================================================================

# Option 1: OAuth token (Pro/Max subscription) - Run 'claude setup-token' to get this
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Option 2: API key
# ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# Domain Configuration (for production with SSL)
# =============================================================================

# Your demo domain (for Let's Encrypt SSL)
# DOMAIN=demo.confluence-skills.dev
