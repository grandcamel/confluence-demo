# Search Scenario - Tests confluence-search skill
# CQL queries and text search operations
#
# Tool expectation pattern for conversation mode:
# - First prompt: must_call [Skill] (loads context, then Bash executes CLI)
# - Subsequent prompts: no tool requirement (may use context or call CLI)
---
prompt: |
  Search for all pages in CDEMO space
expect:
  tools:
    must_call: [Skill]
  text:
    must_contain: [Product Documentation, Team Resources]
    must_not_contain: [error, "I don't have access", "I couldn't find"]
  semantic: |
    Response should list pages from CDEMO space with page titles.
    Should use confluence-search skill with CQL query.
---
prompt: |
  Find pages with the label 'api' in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [API Reference]
    must_not_contain: [error, failed]
  semantic: |
    Response should find the API Reference page which has the 'api' label.
---
prompt: |
  Search for pages containing 'authentication' in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [API]
    must_not_contain: [error, failed]
  semantic: |
    Response should find pages containing the word authentication,
    likely the API Reference page.
---
prompt: |
  Find all pages labeled 'technical' in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [API Reference, Architecture]
    must_not_contain: [error, failed]
  semantic: |
    Response should find pages with the 'technical' label,
    including API Reference and Architecture Diagram.
---
prompt: |
  Search for pages with label 'planning' in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [Q1 Planning]
    must_not_contain: [error, failed]
  semantic: |
    Response should find the Q1 Planning page which has the 'planning' label.
---
prompt: |
  Find pages modified in the last 7 days in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_not_contain: [error, failed]
  semantic: |
    Response should show recently modified pages.
    May show demo pages if recently seeded.
---
prompt: |
  Search for pages under Product Documentation in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [API Reference, Getting Started, Release Notes]
    must_not_contain: [error, failed]
  semantic: |
    Response should find child pages of Product Documentation,
    including API Reference, Getting Started Guide, and Release Notes.
---
prompt: |
  Find pages with label 'release' in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [Release Notes]
    must_not_contain: [error, failed]
  semantic: |
    Response should find the Release Notes v2.0 page which has the 'release' label.
---
prompt: |
  Search for pages mentioning 'microservices' in CDEMO
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [Architecture]
    must_not_contain: [error, failed]
  semantic: |
    Response should find the Architecture Diagram page
    which mentions microservices architecture.
---
prompt: |
  Export the search results for 'label = demo' to CSV
expect:
  tools:
    must_call: [Bash]
  text:
    must_contain: [csv, export]
    must_not_contain: [error, failed]
  semantic: |
    Response should confirm export of search results
    to CSV format.
---
